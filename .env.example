# KAGELOT Studio Client — environment
# Copy this file to `.env` and fill in your key. `.env` is gitignored — never commit it.

# Your KAGELOT API key (ask the KAGELOT team). Tied to your account + credit balance.
KAGELOT_API_KEY=kgl_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the KAGELOT server URL (defaults to production in .mcp.json)
# KAGELOT_MCP_URL=https://kagelot.com/api/mcp
